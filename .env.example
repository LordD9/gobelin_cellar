# Image (utilisée si tu pull depuis GHCR plutôt que de builder)
GOBLIN_CELLAR_IMAGE=ghcr.io/lordd9/gobelin_cellar:latest

# Port publié sur l'hôte (l'app écoute 3001 dans le conteneur)
GOBLIN_CELLAR_PORT=8080

# Dossier SQLite sur l'hôte (sauvegarde = ce répertoire)
DATA_DIR=./data

# Fuseau horaire du dashboard / des logs
TZ=Europe/Paris

# Ollama (scan d'étiquette). Par défaut : Ollama sur l'hôte.
# Si Ollama est dans un autre conteneur du même réseau : http://ollama:11434
OLLAMA_URL=http://host.docker.internal:11434
# OLLAMA_VLM_MODEL=qwen3-vl:2b
# OLLAMA_LLM_MODEL=llama3.2:3b
# SEARXNG_URL=http://searxng:8080
