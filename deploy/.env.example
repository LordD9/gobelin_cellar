# Image publiée (laisse latest, ou épingle un tag : v1.0.0, sha-abc1234)
GOBLIN_CELLAR_IMAGE=ghcr.io/lordd9/gobelin_cellar:latest

# Port publié sur l'hôte (l'app écoute 3001 dans le conteneur)
GOBLIN_CELLAR_PORT=8080

# Dossier SQLite sur l'hôte (sauvegarde = ce répertoire)
DATA_DIR=./data

# Fuseau horaire du dashboard / des logs
TZ=Europe/Paris
